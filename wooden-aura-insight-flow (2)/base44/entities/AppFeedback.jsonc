{
  "name": "AppFeedback",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "bug",
        "feature_request",
        "suggestion",
        "general"
      ],
      "default": "suggestion",
      "description": "Type of feedback"
    },
    "title": {
      "type": "string",
      "description": "Short title"
    },
    "content": {
      "type": "string",
      "description": "Detailed feedback content"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewing",
        "planned",
        "completed"
      ],
      "default": "submitted"
    }
  },
  "required": [
    "type",
    "content"
  ]
}