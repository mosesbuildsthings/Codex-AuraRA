{
  "name": "RelationshipGoal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The goal title"
    },
    "description": {
      "type": "string",
      "description": "More detail about the goal"
    },
    "category": {
      "type": "string",
      "enum": [
        "communication",
        "quality_time",
        "intimacy",
        "conflict_resolution",
        "personal_growth",
        "adventure",
        "other"
      ],
      "default": "communication"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "paused"
      ],
      "default": "not_started"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "linked_case_id": {
      "type": "string",
      "description": "Optional reference to an AnalysisCase"
    },
    "linked_insight": {
      "type": "string",
      "description": "The specific insight or advice snippet this goal came from"
    },
    "progress_notes": {
      "type": "string",
      "description": "User's running notes on progress"
    }
  },
  "required": [
    "title"
  ]
}