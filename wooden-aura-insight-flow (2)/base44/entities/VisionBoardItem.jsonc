{
  "name": "VisionBoardItem",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "image",
        "quote",
        "note"
      ],
      "description": "Type of vision board item"
    },
    "title": {
      "type": "string",
      "description": "Title or heading of the item"
    },
    "content": {
      "type": "string",
      "description": "Image URL, quote text, or note content"
    },
    "category": {
      "type": "string",
      "enum": [
        "adventure",
        "intimacy",
        "growth",
        "stability",
        "communication",
        "fun",
        "legacy",
        "health"
      ],
      "default": "growth",
      "description": "Goal category this item represents"
    },
    "position_x": {
      "type": "number",
      "default": 0,
      "description": "Horizontal position on board (0-100%)"
    },
    "position_y": {
      "type": "number",
      "default": 0,
      "description": "Vertical position on board (0-100%)"
    },
    "color": {
      "type": "string",
      "default": "bg-primary/10",
      "description": "Background color class for styling"
    },
    "partner_email": {
      "type": "string",
      "description": "Partner email to share this board with"
    },
    "shared": {
      "type": "boolean",
      "default": false,
      "description": "Whether item is visible to partner"
    }
  },
  "required": [
    "type",
    "title",
    "content"
  ]
}